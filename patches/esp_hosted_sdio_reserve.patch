+	/* LOCAL PATCH: slab first, heap as the overflow for deep bursts. */
+	void *p = sdio_reserve_take();
+	if (!p) {
+		p = eh_host_port_dma_alloc(MAX_SDIO_BUFFER_SIZE);
+		if (p) {
+			sdio_reserve_overflows++;
+			if (!sdio_reserve_spilled) {
