+/* ---- LOCAL PATCH (weather_display, 2026-09-22): reserve pool -------------
+ *
+ * A slab of SDIO_RESERVE_BLOCKS buffers, claimed once at init — before the
+ * application has had any chance to fill internal RAM — and used as the
+ * transport's primary allocator, with the heap kept as the overflow path for
+ * bursts deeper than the slab. Two things follow from that order. The link,
+ * and with it the RPC channel to the co-processor, keeps moving even when the
+ * heap is dry, instead of going silent until someone pulls the plug. And
+ * ordinary packet traffic stops churning the general heap at all, which is
+ * what was fragmenting it underneath the TLS session it shares memory with.
+ *
+ * Serving the slab *last* was tried first and measured worse: packets kept
+ * cycling through the general heap, and its low-water mark during the TLS
+ * handshake fell to 11.5 KiB, because the slab had been carved out of the
+ * very pool the handshake needed.
+ *
+ * Deliberately small: at 1536 bytes a block this is internal DMA-capable RAM
+ * that nothing else can use again, and the whole DMA heap on this board has
+ * only ~62 KiB free at idle and dipped to 34 KiB during the TLS handshake
+ * before the slab existed (review/ota-sdio-buffer-2026-09-22.md). 16 blocks
+ * left just 8-11 KiB for everything else at that moment, which is thinner
+ * than the 2560-byte RX staging buffer has already failed at once; 8 blocks
+ * keeps ~22 KiB and still covers the case this is for — an RPC request and
+ * its answer plus a few frames, not sustained throughput. Deep bursts spill
+ * to the heap as before. Resize with the `reserve ... min` figure from a run
+ * under real load, not by guessing.
+ *
+ * The slab is never freed: a buffer handed to an upper layer can come back
+ * long after a transport restart (esp_hosted_deinit() during the C6 OTA does
+ * exactly that), and a reserve that survives the restart is both safer and
+ * more useful than one that has to be rebuilt from a heap that may be full. */
+#define SDIO_RESERVE_BLOCKS  8
+
+static uint8_t *sdio_reserve_slab;
+static uint8_t *sdio_reserve_slab_end;
+static void    *sdio_reserve_head;      /* freelist, next pointer inside the block */
+static eh_host_port_mutex_t *sdio_reserve_lock;
+static uint32_t sdio_reserve_avail;
+static uint32_t sdio_reserve_min_avail; /* low-water mark, diagnostics */
+static uint32_t sdio_reserve_overflows; /* allocations the slab could not serve */
+static bool     sdio_reserve_spilled;   /* log the first overflow, not all of them */
+
+static void sdio_reserve_init(void)
+{
+	if (sdio_reserve_slab)
+		return;                          /* one-time, survives bus deinit */
+
+	sdio_reserve_lock = eh_host_port_mutex_create();
+	if (!sdio_reserve_lock)
+		return;
+
+	sdio_reserve_slab = (uint8_t *)eh_host_port_dma_alloc_aligned(
+			(size_t)SDIO_RESERVE_BLOCKS * MAX_SDIO_BUFFER_SIZE,
+			HOSTED_MEM_ALIGNMENT_64);
+	if (!sdio_reserve_slab) {
+		ESP_LOGW(TAG, "SDIO reserve pool unavailable (%u x %u B); heap only",
+		         (unsigned)SDIO_RESERVE_BLOCKS, (unsigned)MAX_SDIO_BUFFER_SIZE);
+		eh_host_port_mutex_destroy(sdio_reserve_lock);
+		sdio_reserve_lock = NULL;
+		return;
+	}
+	sdio_reserve_slab_end = sdio_reserve_slab +
+			(size_t)SDIO_RESERVE_BLOCKS * MAX_SDIO_BUFFER_SIZE;
+
+	sdio_reserve_head = NULL;
+	for (int i = SDIO_RESERVE_BLOCKS - 1; i >= 0; i--) {
+		uint8_t *b = sdio_reserve_slab + (size_t)i * MAX_SDIO_BUFFER_SIZE;
+		*(void **)b = sdio_reserve_head;
+		sdio_reserve_head = b;
+	}
+	sdio_reserve_avail = SDIO_RESERVE_BLOCKS;
+	sdio_reserve_min_avail = SDIO_RESERVE_BLOCKS;
+
+	ESP_LOGI(TAG, "SDIO reserve pool: %u x %u B (dma_free now %u)",
+	         (unsigned)SDIO_RESERVE_BLOCKS, (unsigned)MAX_SDIO_BUFFER_SIZE,
+	         SDIO_OOM_FREE());
+}
+
+static void *sdio_reserve_take(void)
+{
+	void *b;
+
+	if (!sdio_reserve_slab)
+		return NULL;
+
+	eh_host_port_mutex_lock(sdio_reserve_lock);
+	b = sdio_reserve_head;
+	if (b) {
+		sdio_reserve_head = *(void **)b;
+		sdio_reserve_avail--;
+		if (sdio_reserve_avail < sdio_reserve_min_avail)
+			sdio_reserve_min_avail = sdio_reserve_avail;
+	}
+	eh_host_port_mutex_unlock(sdio_reserve_lock);
+	return b;
+}
+
+/* True when `p` belonged to the reserve and has been returned to it. */
+static bool sdio_reserve_give(void *p)
+{
+	if (!sdio_reserve_slab ||
+	    (uint8_t *)p < sdio_reserve_slab || (uint8_t *)p >= sdio_reserve_slab_end)
+		return false;
+
+	eh_host_port_mutex_lock(sdio_reserve_lock);
+	*(void **)p = sdio_reserve_head;
+	sdio_reserve_head = p;
+	sdio_reserve_avail++;
+	eh_host_port_mutex_unlock(sdio_reserve_lock);
+	return true;
+}
