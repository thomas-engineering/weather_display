+/* ---- LOCAL PATCH: bounded wait instead of dropping on the first miss -----
+ *
+ * A dropped TX packet is a TCP segment the peer has to time out and
+ * retransmit — or, on the control queue, an RPC request to the co-processor
+ * that nothing ever retransmits: the host waits 5 s for an answer that can no
+ * longer come, and repeats that forever. That is the failure that needed a
+ * power cycle, so the control queue gets a far longer budget than the data
+ * queues. Sleeping here is the point, not a side effect: these tasks run at
+ * priority 22, so yielding is what lets the tasks holding the memory run and
+ * give it back. No bus lock is held at either call site. */
+#define SDIO_TX_ALLOC_RETRY_MS     10
+#define SDIO_TX_ALLOC_RETRIES_DATA 3    /* ~30 ms */
+#define SDIO_TX_ALLOC_RETRIES_CTRL 20   /* ~200 ms */
+/* RX is kept short on purpose: the staging ring behind it is only two slots
+ * deep, so waiting here stalls reads from the slave rather than the sender. */
+#define SDIO_RX_ALLOC_RETRY_MS     5
+#define SDIO_RX_ALLOC_RETRIES      2
+
+static void *sdio_buffer_alloc_waiting(unsigned int need_memset, int retries,
+                                       uint32_t retry_ms)
+{
+	void *p = sdio_buffer_alloc(need_memset);
+
+	while (!p && retries-- > 0) {
+		eh_host_port_task_delay_ms(retry_ms);
+		if (!s_running)
+			return NULL;
+		p = sdio_buffer_alloc(need_memset);
+	}
+	return p;
+}
